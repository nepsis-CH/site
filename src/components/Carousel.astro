---
import { type Locale, useTranslations, withBase } from '../i18n';

/**
 * Carusel de imagini care rulează singur (se oprește la hover/atingere și
 * pentru vizitatorii cu `prefers-reduced-motion`). Fără librării externe.
 */
interface Props {
  images: { src: string; alt: string; href?: string; caption?: string }[];
  lang: Locale;
  class?: string;
}

const { images, lang, class: extra = '' } = Astro.props;
const t = useTranslations(lang);
---

{
  images.length > 0 && (
    <div
      class:list={['group relative overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm', extra]}
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label={t('carousel.label')}
    >
      <div
        class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-carousel-track
      >
        {images.map((img, i) => (
          <figure class="relative w-full shrink-0 snap-center">
            {img.href ? (
              <a href={img.href}>
                <img
                  src={withBase(img.src)}
                  alt={img.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover"
                />
              </a>
            ) : (
              <img
                src={withBase(img.src)}
                alt={img.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="aspect-[3/2] w-full object-cover"
              />
            )}
            {img.caption && (
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-3 pt-8 text-sm font-medium text-white">
                {img.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>

      {
        images.length > 1 && (
          <>
            <button
              type="button"
              data-carousel-prev
              aria-label={t('carousel.prev')}
              class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-white/85 p-2 text-brand-900 shadow-md transition hover:bg-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              type="button"
              data-carousel-next
              aria-label={t('carousel.next')}
              class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-white/85 p-2 text-brand-900 shadow-md transition hover:bg-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
            <div
              class="pointer-events-none absolute inset-x-0 bottom-2 flex justify-center gap-1.5"
              data-carousel-dots
              aria-hidden="true"
            >
              {images.map(() => (
                <span class="h-1.5 w-1.5 rounded-full bg-white/60 shadow transition-colors" />
              ))}
            </div>
          </>
        )
      }
    </div>
  )
}

<script>
  const INTERVAL = 4500;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;
    const slides = track.children.length;
    const dots = root.querySelectorAll<HTMLElement>('[data-carousel-dots] span');

    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (i: number) => {
      const target = ((i % slides) + slides) % slides;
      track.scrollTo({ left: target * track.clientWidth, behavior: 'smooth' });
    };
    const paint = () => {
      dots.forEach((d, i) => d.classList.toggle('bg-white', i === index()));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(paint), { passive: true });
    paint();

    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => goTo(index() - 1));
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => goTo(index() + 1));

    // Rulare automată — doar dacă vizitatorul nu preferă mișcare redusă.
    if (slides < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let timer: ReturnType<typeof setInterval> | undefined;
    const start = () => {
      stop();
      timer = setInterval(() => {
        if (document.hidden) return;
        goTo(index() + 1);
      }, INTERVAL);
    };
    const stop = () => timer && clearInterval(timer);
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('touchstart', stop, { passive: true });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>
