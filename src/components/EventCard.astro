---
import { render, type CollectionEntry } from 'astro:content';
import { type Locale, useTranslations, formatDate, formatMonthYear, withBase } from '../i18n';

/**
 * Card de eveniment. `detailed` afișează și descrierea completă (folosit la
 * evenimentele viitoare); fără el, cardul rămâne compact (arhiva).
 */
interface Props {
  event: CollectionEntry<'evenimente'>;
  lang: Locale;
  detailed?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { event, lang, detailed = false, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(event);
const Heading = headingLevel;
---

<article
  id={`eveniment-${event.data.translationKey}`}
  class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm"
>
  <div class:list={[detailed && event.data.image && 'md:grid md:grid-cols-2']}>
    {
      event.data.image && (
        <img
          src={withBase(event.data.image)}
          alt={event.data.imageAlt ?? event.data.title}
          loading="lazy"
          class:list={['h-full w-full object-cover', detailed ? 'max-h-[34rem]' : 'aspect-[4/3]']}
        />
      )
    }
    <div class="flex flex-col gap-3 p-6">
      <Heading class="text-xl font-semibold text-brand-900 sm:text-2xl">{event.data.title}</Heading>
      <p class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
        <span class="inline-flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 9h18M8 3v4M16 3v4" />
          </svg>
          {/* Fără zi cunoscută arătăm doar luna: ziua din fișier e doar pentru sortare. */}
          <time datetime={event.data.date.toISOString().slice(0, event.data.showDay ? 10 : 7)}>
            {event.data.showDay ? formatDate(event.data.date, lang) : formatMonthYear(event.data.date, lang)}
          </time>
        </span>
        {
          event.data.location && (
            <span class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
              {event.data.location}
            </span>
          )
        }
      </p>
      {
        detailed && (
          <div class="prose-md text-stone-700">
            <Content />
          </div>
        )
      }
      {
        detailed && event.data.registrationLink && (
          <p class="mt-2">
            <a
              href={event.data.registrationLink}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-lg bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
            >
              {t('activities.register')}
            </a>
          </p>
        )
      }
      {!detailed && <slot />}
    </div>
  </div>
</article>
