---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath } from '../i18n';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import SocialLinks from './SocialLinks.astro';
import sigla from '../assets/sigla-nepsis.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-stone-200 bg-brand-950 text-stone-300">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-14 text-center">
    <a href={localePath(lang, '/')} class="flex flex-col items-center gap-4">
      <span class="flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-md">
        <Image src={sigla} alt="" width="120" height="120" format="webp" class="h-14 w-14 object-contain" loading="lazy" />
      </span>
      <span class="font-serif text-2xl font-bold text-white">{t('site.name')}</span>
    </a>

    <p class="max-w-md text-sm leading-relaxed text-stone-400">{t('home.tagline')}</p>

    <SocialLinks class="justify-center gap-3 [&_a]:text-stone-400 [&_a:hover]:bg-brand-800 [&_a:hover]:text-white" />

    <p class="text-sm">
      <ObfuscatedEmail class="text-brand-200 underline decoration-brand-700 underline-offset-2 hover:text-white" />
      <span class="mx-2 text-stone-600" aria-hidden="true">·</span>
      <a href={localePath(lang, '/newsletter/')} class="underline decoration-brand-700 underline-offset-2 hover:text-white">
        {t('contact.newsletterLink')}
      </a>
    </p>
  </div>

  <div class="border-t border-brand-900">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-stone-400">
      © {year} Nepsis Elvetia. {t('footer.rights')}
    </p>
  </div>
</footer>
