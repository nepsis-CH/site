---
import { type Locale, useTranslations } from '../i18n';

/**
 * Bandă de imagini pe toată lățimea paginii, care rulează non-stop
 * (animație CSS, fără JavaScript). Se oprește la hover; pentru vizitatorii
 * cu `prefers-reduced-motion` devine o listă derulabilă manual.
 */
interface Props {
  images: { src: string; alt: string; href?: string }[];
  lang: Locale;
}

const { images, lang } = Astro.props;
const t = useTranslations(lang);
// Viteză constantă indiferent de numărul de imagini (~5s pe imagine).
const durata = Math.max(30, images.length * 5);
---

{
  images.length > 0 && (
    <div class="marquee group/marquee w-full overflow-hidden" role="region" aria-label={t('carousel.label')}>
      <div class="marquee-track flex w-max" style={`--durata: ${durata}s`}>
        {[false, true].map((clone) => (
          <ul class="flex shrink-0 gap-3 pr-3" aria-hidden={clone ? 'true' : undefined}>
            {images.map((img) => (
              <li class="h-52 shrink-0 sm:h-64">
                {img.href && !clone ? (
                  <a href={img.href} class="block h-full" title={img.alt}>
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-auto rounded-lg object-cover"
                    />
                  </a>
                ) : (
                  <img
                    src={img.src}
                    alt={clone ? '' : img.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-auto rounded-lg object-cover"
                  />
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  )
}

<style>
  .marquee-track {
    animation: defilare var(--durata) linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @keyframes defilare {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
    }
    /* Fără animație nu e nevoie de clonă. */
    .marquee-track ul[aria-hidden='true'] {
      display: none;
    }
  }
</style>
