---
import { type Locale, useTranslations, localePath, stripLocale, locales } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = stripLocale(Astro.url.pathname);
const names: Record<Locale, string> = { ro: 'Română', fr: 'Français', en: 'English', de: 'Deutsch' };
---

<nav aria-label={t('nav.language')} class="flex items-center gap-1 text-sm">
  {
    locales.map((l) => (
      <a
        href={localePath(l, path)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'true' : undefined}
        title={names[l]}
        class:list={[
          'rounded px-2 py-1 font-medium uppercase tracking-wide transition-colors',
          l === lang
            ? 'bg-brand-800 text-white'
            : 'text-stone-500 hover:bg-brand-50 hover:text-brand-900',
        ]}
      >
        {l}
      </a>
    ))
  }
</nav>
