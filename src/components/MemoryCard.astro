---
import type { CollectionEntry } from 'astro:content';
import { type Locale, formatDate, useTranslations, withBase } from '../i18n';

/**
 * O amintire în cronologie, ca fișă de aceeași mărime cu toate celelalte:
 * fotografia are același format peste tot, titlul și rezumatul se opresc fiecare
 * la două rânduri, iar butonul stă mereu în același loc.
 *
 * Formatul 4:3 e obligatoriu, nu decorativ: fără el, o poză portret și-ar impune
 * înălțimea naturală și fișele n-ar mai ieși la fel. Pe ecran mare flexbox întinde
 * apoi imaginea pe toată înălțimea fișei, care e fixă fiindcă titlul, data și
 * rezumatul au fiecare înălțime rezervată.
 *
 * Uniformitatea are un cost: fotografiile late se decupează pe margini. Încadrarea
 * e ținută puțin peste centru (42%), acolo unde stau de obicei chipurile în pozele
 * de grup, ca pierderea să fie cât mai mică.
 */
interface Props {
  memory: CollectionEntry<'amintiri'>;
  lang: Locale;
  /** Link către pagina proprie a amintirii. */
  href: string;
  /** Primele rânduri din text, deja curățate de marcaje. */
  rezumat: string;
  /** Fotografia deasupra, nu lângă text — pentru grile cu coloane înguste. */
  vertical?: boolean;
}

const { memory, lang, href, rezumat, vertical = false } = Astro.props;
const t = useTranslations(lang);
const cover = memory.data.images[0];
---

<article
  class:list={[
    'flex flex-col gap-5 rounded-xl border border-stone-200 bg-white p-5 shadow-sm',
    !vertical && 'sm:flex-row sm:p-6',
  ]}
>
  {
    cover ? (
      <img
        src={withBase(cover.src)}
        alt={cover.alt}
        loading="lazy"
        width="560"
        height="420"
        class:list={['aspect-[4/3] w-full shrink-0 rounded-lg object-cover object-[50%_42%]', !vertical && 'sm:w-56']}
      />
    ) : (
      <div class:list={['flex aspect-[4/3] w-full shrink-0 items-center justify-center rounded-lg bg-brand-50', !vertical && 'sm:w-56']}>
        <span class="font-serif text-2xl text-brand-300">Nepsis</span>
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col">
    {/* Titlul și rezumatul au înălțime rezervată, ca toate fișele să iasă la fel. */}
    <h3 class="line-clamp-2 min-h-[3.5rem] text-xl font-semibold text-brand-900">
      <a href={href} class="decoration-brand-300 underline-offset-4 hover:underline">{memory.data.title}</a>
    </h3>
    <p class="min-h-[1.5rem] text-sm text-stone-500">
      {
        memory.data.date && memory.data.showDate && (
          <time datetime={memory.data.date.toISOString().slice(0, 10)}>{formatDate(memory.data.date, lang)}</time>
        )
      }
    </p>
    <p class="mt-2 line-clamp-2 min-h-[3.25rem] text-stone-700">{rezumat}</p>
    <p class="mt-auto pt-4">
      <a
        href={href}
        class="inline-block rounded-lg bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        {t('memories.readMore')}
      </a>
    </p>
  </div>
</article>
