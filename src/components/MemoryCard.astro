---
import { render, type CollectionEntry } from 'astro:content';
import { type Locale, formatDate, useTranslations, withBase } from '../i18n';

/** O amintire în cronologie: text (din Markdown) + prima fotografie; restul se văd pe pagina proprie. */
interface Props {
  memory: CollectionEntry<'amintiri'>;
  lang: Locale;
  /** Link către pagina proprie a amintirii — titlul devine clicabil și apare „Citește mai mult”. */
  href?: string;
}

const { memory, lang, href } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(memory);
const cover = memory.data.images[0];
---

<article class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <header>
    <h3 class="text-xl font-semibold text-brand-900 sm:text-2xl">
      {
        href ? (
          <a href={href} class="decoration-brand-300 underline-offset-4 hover:underline">
            {memory.data.title}
          </a>
        ) : (
          memory.data.title
        )
      }
    </h3>
    {
      memory.data.date && memory.data.showDate && (
        <p class="mt-1 text-sm text-stone-500">
          <time datetime={memory.data.date.toISOString().slice(0, 10)}>
            {formatDate(memory.data.date, lang)}
          </time>
        </p>
      )
    }
  </header>
  <div class:list={['mt-5 gap-8', cover && 'md:grid md:grid-cols-2']}>
    <div class="prose-md text-stone-700">
      <Content />
    </div>
    {
      cover && (
        <div class="mt-6 content-start md:mt-0">
          <img src={withBase(cover.src)} alt={cover.alt} loading="lazy" class="w-full rounded-lg object-cover" />
          {href && (
            <p class="mt-4 text-center">
              <a
                href={href}
                class="inline-block rounded-lg bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
              >
                {t('memories.readMore')}
              </a>
            </p>
          )}
        </div>
      )
    }
  </div>
  {
    !cover && href && (
      <p class="mt-5">
        <a
          href={href}
          class="inline-block rounded-lg bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
        >
          {t('memories.readMore')}
        </a>
      </p>
    )
  }
</article>
