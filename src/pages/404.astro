---
import Base from '../layouts/Base.astro';
import { defaultLocale, useTranslations } from '../i18n';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t('notFound.title')} · ${t('site.name')}`} description={t('notFound.text')}>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-serif text-7xl font-bold text-brand-200">404</p>
    <h1 class="mt-4 font-serif text-3xl font-bold text-brand-950">{t('notFound.title')}</h1>
    <p class="mt-3 text-lg text-stone-600">{t('notFound.text')}</p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-block rounded-lg bg-brand-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        {t('notFound.home')}
      </a>
    </p>
  </div>
</Base>
