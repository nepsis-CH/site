---
import Base from '../../../layouts/Base.astro';
import MemoryCard from '../../../components/MemoryCard.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, defaultLocale } from '../../../i18n';
import { getMemoriesByYear, rezumatText } from '../../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii.
const years = await getMemoriesByYear(lang);
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('memories.title')}</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600">{t('memories.intro')}</p>
    {lang !== defaultLocale && <p class="mt-2 text-sm italic text-stone-500">{t('memories.onlyRo')}</p>}

    <!-- Cuprins pe ani -->
    <nav aria-label={t('memories.year')} class="mt-6 flex flex-wrap gap-2">
      {
        years.map(({ year }) => (
          <a
            href={`#an${year}`}
            class="rounded-full border border-brand-200 bg-white px-4 py-1.5 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {year}
          </a>
        ))
      }
    </nav>

    <!-- Cronologie -->
    <div class="mt-12 space-y-16">
      {
        years.map(({ year, entries }) => (
          <section aria-labelledby={`an${year}`}>
            <h2
              id={`an${year}`}
              class="scroll-mt-24 border-b-2 border-brand-200 pb-2 font-serif text-3xl font-bold text-brand-900"
            >
              {t('memories.year')} {year}
            </h2>

            {/*
              Firul din stânga curge pe măsură ce derulezi anul: cel palid e traseul
              întreg, cel colorat arată cât ai parcurs.
            */}
            <div class="cronologie relative mt-8 pl-6 sm:pl-8" data-cronologie>
              <span class="absolute top-0 left-0 h-full w-0.5 bg-brand-100" aria-hidden="true" />
              <span class="cronologie__fir-plin absolute top-0 left-0 w-0.5 bg-brand-600" aria-hidden="true" />

              <div class="space-y-8">
                {entries.map(({ memory, slug }) => (
                  <div class="amintire relative">
                    <span
                      class="punct absolute -left-[29px] top-8 h-3 w-3 rounded-full border-2 border-white bg-brand-500 sm:-left-[37px]"
                      aria-hidden="true"
                    />
                    <MemoryCard
                      memory={memory}
                      lang={lang}
                      href={localePath(lang, `/amintiri/${slug}/`)}
                      rezumat={rezumatText(memory.body)}
                    />
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  // Animația cronologiei. Se pornește numai dacă vizitatorul n-a cerut mai puțină
  // mișcare — fără clasa asta, fișele sunt vizibile din primul cadru, deci pagina
  // se citește la fel și dacă scriptul nu rulează deloc.
  const containere = document.querySelectorAll<HTMLElement>('[data-cronologie]');
  const miscareRedusa = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (containere.length > 0 && !miscareRedusa) {
    containere.forEach((c) => c.classList.add('cronologie--vie'));

    // Fișele apar pe rând, când intră în ecran.
    const observator = new IntersectionObserver(
      (intrari) => {
        intrari.forEach((intrare) => {
          if (!intrare.isIntersecting) return;
          intrare.target.classList.add('vazuta');
          observator.unobserve(intrare.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );
    document.querySelectorAll('.amintire').forEach((a) => observator.observe(a));

    // Firul se umple urmărind poziția de citire, puțin înaintea ei.
    let planificat = false;
    const deseneaza = () => {
      planificat = false;
      const reper = window.innerHeight * 0.62;
      containere.forEach((c) => {
        const r = c.getBoundingClientRect();
        const progres = Math.max(0, Math.min(1, (reper - r.top) / r.height));
        c.style.setProperty('--progres', `${(progres * 100).toFixed(2)}%`);
      });
    };
    const cere = () => {
      if (planificat) return;
      planificat = true;
      requestAnimationFrame(deseneaza);
    };

    window.addEventListener('scroll', cere, { passive: true });
    window.addEventListener('resize', cere);
    deseneaza();
  }
</script>
