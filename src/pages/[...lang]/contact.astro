---
import Base from '../../layouts/Base.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t('contact.title')} · ${t('site.name')}`} description={t('contact.description')}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('contact.title')}</h1>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <!-- E-mail -->
      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="contact-email">
        <h2 id="contact-email" class="text-xl font-semibold text-brand-900">{t('contact.writeUs')}</h2>
        <p class="mt-3 text-stone-700">
          {t('contact.emailIntro')}
          <ObfuscatedEmail class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900" />
        </p>
        <p class="mt-6">
          <!-- Butonul asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
          <a
            href="#"
            class="email-protejat-buton inline-block rounded-lg bg-brand-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
            data-x="nepsis.ch"
            data-y="mitropolia"
            data-z="eu"
          >
            {t('contact.emailButton')}
          </a>
        </p>
        <p class="mt-6 text-stone-700">
          <a
            href={localePath(lang, '/newsletter/')}
            class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
          >
            {t('contact.newsletterLink')}
          </a>
        </p>
      </section>

      <!-- Grupuri + social -->
      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="contact-grupuri">
        <h2 id="contact-grupuri" class="text-xl font-semibold text-brand-900">{t('contact.groups')}</h2>
        <p class="mt-3 text-stone-700">{t('contact.groupsText')}</p>
        <h3 class="mt-6 text-base font-semibold text-brand-900">{t('contact.social')}</h3>
        <SocialLinks class="mt-3 -ml-2" />
      </section>

      <!-- Cont bancar -->
      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="contact-banca">
        <h2 id="contact-banca" class="text-xl font-semibold text-brand-900">{t('contact.bank')}</h2>
        <dl class="mt-4 space-y-2 text-stone-700">
          <div>
            <dt class="inline font-semibold">IBAN:</dt>
            <dd class="inline">CH95 0900 0000 1545 2680 8</dd>
          </div>
          <div>
            <dt class="inline font-semibold">BIC:</dt>
            <dd class="inline">POFICHBEXXX</dd>
          </div>
          <div>
            <dt class="inline font-semibold">{t('contact.bank.holder')}:</dt>
            <dd class="inline">Nepsis Elvetia</dd>
          </div>
        </dl>
      </section>

      <!-- Adrese utile -->
      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="contact-utile">
        <h2 id="contact-utile" class="text-xl font-semibold text-brand-900">{t('contact.useful')}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-stone-700">
          <li>
            <a href="http://www.nepsis.org/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.nepsis')}
            </a>
          </li>
          <li>
            <a href="http://www.mitropolia.eu/ro/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.mitropolia')}
            </a>
          </li>
          <li>
            <a href="http://www.mitropolia.eu/ro/site/172/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.parohii')}
            </a>
          </li>
          <li>
            <a href="http://monasteresuisse.mitropolia.eu/" target="_blank" rel="noopener" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
              {t('contact.useful.manastire')}
            </a>
          </li>
          <li>
            {t('contact.useful.pelerinaje')}
            <ObfuscatedEmail x="pelerin" class="text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900" />
          </li>
        </ul>
      </section>
    </div>
  </div>
</Base>

<script>
  // Același mecanism anti-spam și pentru butonul mare de e-mail.
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>
