---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('devino-membru', lang);
---

<Base
  lang={lang}
  title={`${t('join.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('join.description')}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{entry.data.title}</h1>
    <div class="prose-md mt-8 text-stone-700">
      <Content />
    </div>
    <p class="mt-10">
      <!-- Butonul asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
      <a
        href="#"
        class="email-protejat-buton inline-block rounded-lg bg-brand-800 px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
        data-x="nepsis.ch"
        data-y="mitropolia"
        data-z="eu"
      >
        {t('join.cta')} →
      </a>
    </p>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>
