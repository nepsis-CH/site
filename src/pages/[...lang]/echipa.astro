---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, withBase, type UIKey } from '../../i18n';
import { getMembers } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const members = await getMembers();

/*
  Echipa de azi merge într-o singură înșiruire — coordonatorii, iar la urmă
  părintele responsabil, cum a cerut utilizatorul — fără titlu de secțiune,
  fiindcă titlul paginii o numește deja. Foștii coordonatori vin separat.
*/
const sectiuni = [
  { grup: 'echipa', titluri: ['coordonatori', 'responsabil'], titlu: null },
  { grup: 'alumni', titluri: ['alumni'], titlu: t('members.section.alumni') },
]
  .map((s) => ({ ...s, oameni: members.filter((m) => s.titluri.includes(m.data.group)) }))
  .filter((s) => s.oameni.length > 0);

/**
 * Iniţiala pentru cercul celor fără fotografie. Titulatura („Părintele”) nu
 * spune nimic despre persoană, așa că o sărim: „Părintele Ștefan I.” → „Ș”.
 */
const titulaturi = ['părintele', 'pr.', 'père', 'le père', 'father', 'vater', 'diacon', 'diac.', 'diacre', 'deacon', 'diakon'];
function initiala(nume: string): string {
  const cuvinte = nume.split(/\s+/).filter((c) => !titulaturi.includes(c.toLowerCase()));
  return (cuvinte[0] ?? nume).charAt(0).toUpperCase();
}
---

<Base lang={lang} title={`${t('members.title')} · ${t('site.name')}`} description={t('members.description')}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <header class="text-center">
      <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('members.heading')}</h1>
      <p class="mt-2 text-lg text-stone-600">{t('members.subtitle')}</p>
    </header>

    {
      sectiuni.map((sectiune) => (
        <section class="mt-14" aria-labelledby={sectiune.titlu ? `echipa-${sectiune.grup}` : undefined}>
          {sectiune.titlu && (
            <h2
              id={`echipa-${sectiune.grup}`}
              class="border-b border-stone-200 pb-2 font-serif text-xl font-bold text-brand-800"
            >
              {sectiune.titlu}
            </h2>
          )}
          <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            {sectiune.oameni.map((member) => (
              <li class="text-center">
                {/*
                  Cine nu are încă fotografie primește un cerc cu iniţiala, nu o
                  poză goală: locul rămâne la fel de mare, deci rândul nu sare.
                */}
                {member.data.photo ? (
                  <img
                    src={withBase(member.data.photo)}
                    alt={member.data.name}
                    loading="lazy"
                    width="240"
                    height="240"
                    class="mx-auto aspect-square w-32 rounded-full border border-stone-200 object-cover object-top shadow-sm sm:w-40"
                  />
                ) : (
                  <span
                    class="mx-auto flex aspect-square w-32 items-center justify-center rounded-full border border-brand-100 bg-brand-50 font-serif text-4xl font-bold text-brand-300 shadow-sm sm:w-40 sm:text-5xl"
                    role="img"
                    aria-label={t('members.missingPhoto')}
                  >
                    {initiala(member.data.name)}
                  </span>
                )}
                <h3 class="mt-4 font-serif text-lg font-semibold text-brand-950">{member.data.name}</h3>
                {member.data.role && (
                  <p class="mt-0.5 text-sm font-medium text-brand-700">
                    {t(`members.role.${member.data.role}` as UIKey)}
                  </p>
                )}
                {member.data.parish && (
                  <p class="text-sm text-stone-500">
                    {/*
                      Părintele răspunde de frăție la nivel de țară, nu de o parohie,
                      deci la el nu punem prefixul „Parohia”.
                    */}
                    {member.data.role === 'responsabil'
                      ? member.data.parish
                      : `${t('members.parish')} ${member.data.parish}`}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="mt-14 text-center text-stone-600">
      {t('members.more')}
      <a
        href={localePath(lang, '/amintiri/')}
        class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
      >
        {t('members.morePage')}</a
      >.
    </p>
  </div>
</Base>
