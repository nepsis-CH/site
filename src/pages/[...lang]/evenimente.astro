---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import CalendarAnual from '../../components/CalendarAnual.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';
import { getEvents, splitEvents, getYearCalendar } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Împărțirea se face automat la fiecare build, după data evenimentului.
const toate = await getEvents(lang);
const { upcoming, past } = splitEvents(toate);

// Recentele afișate pe pagină (doar acestea au card, deci și ancoră).
const recente = past.slice(0, 3);

/*
  Calendarul anual se construiește din aceleași evenimente, nu din tabelul
  scris de mână de dinainte: un singur loc de actualizat. Anul se ia din ceas,
  ca titlul să nu rămână în urmă la 1 ianuarie.
*/
const anul = new Date().getUTCFullYear();
// Calendarul adună și evenimentele anunțate, și amintirile anului: ce urmează
// și ce a fost sunt același an, privit din două momente.
const intrariCalendar = await getYearCalendar(lang, anul, (slug) => localePath(lang, `/amintiri/${slug}/`));
const ancore = new Set([...upcoming, ...recente].map((e) => e.data.translationKey));
---

<Base lang={lang} title={`${t('activities.title')} · ${t('site.name')}`} description={t('activities.description')}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <!--
      Titlul paginii și fraza de întâmpinare au fost scoase la cererea
      utilizatorului. „Următorul eveniment” urcă în locul lor ca h1: pagina
      trebuie să păstreze un titlu de nivel întâi pentru cititoarele de ecran
      și pentru indexare, iar numele rubricii rămâne în <title>.
    -->
    <section aria-labelledby="urmeaza">
      <h1 id="urmeaza" class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">
        {t('activities.upcoming')}
      </h1>
      {
        upcoming.length === 0 ? (
          <p class="mt-4 max-w-prose rounded-lg border border-brand-100 bg-brand-50 p-5 text-stone-700">
            {t('activities.noUpcoming')}
          </p>
        ) : (
          <div class="mt-6 space-y-8">
            {upcoming.map((event, i) => (
              <EventCard event={event} lang={lang} detailed={i === 0} headingLevel="h3" />
            ))}
          </div>
        )
      }
    </section>

    <!-- Calendarul anual, ca agendă pe luni -->
    <section class="mt-14" aria-labelledby="calendar-anual">
      <h2 id="calendar-anual" class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">
        {t('activities.calendarTitle').replace('{year}', String(anul))}
      </h2>
      <p class="mt-3 max-w-prose text-stone-600">{t('activities.calendarIntro')}</p>
      <CalendarAnual intrari={intrariCalendar} lang={lang} anchors={ancore} />
      <p class="text-sm text-stone-500">{t('activities.calendarNote')}</p>
    </section>

    <!-- Activitate permanentă -->
    <section class="mt-14" aria-labelledby="permanent">
      <div class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm md:grid md:grid-cols-3">
        <Image
          src={psalticaLogo}
          alt={t('psaltica.logoAlt')}
          widths={[400, 700, 1000]}
          sizes="(min-width: 768px) 33vw, 62vw"
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div class="p-6 md:col-span-2 md:p-8">
          <h2 id="permanent" class="text-xl font-semibold text-brand-900 sm:text-2xl">
            {t('activities.permanent')}
          </h2>
          <p class="mt-3 text-stone-700">{t('activities.permanentText')}</p>
          <p class="mt-5">
            <a
              href={localePath(lang, '/psaltica/')}
              class="inline-block rounded-lg bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
            >
              {t('activities.permanentLink')}
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Evenimente recente: doar ultimele 3 -->
    <section class="mt-14" aria-labelledby="recente">
      <h2 id="recente" class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">
        {t('activities.past')}
      </h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recente.map((event) => <EventCard event={event} lang={lang} headingLevel="h3" />)}
      </div>
      <p class="mt-10 text-center">
        <a
          href={localePath(lang, '/amintiri/')}
          class="inline-block rounded-full bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
        >
          {t('home.seeMemories')} →
        </a>
      </p>
    </section>
  </div>
</Base>
