---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { existsSync } from 'node:fs';
import GalleryMarquee from '../../components/GalleryMarquee.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, formatDate } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import colaj from '../../assets/nepsis-elvetia.jpg';
import stema from '../../assets/stema-mitropolia.png';

// Stema pictată (color) se folosește automat de îndată ce fișierul există în public/img/.
const stemaColor = existsSync(new URL('../../../public/img/stema-mitropolia-color.png', import.meta.url))
  ? '/img/stema-mitropolia-color.png'
  : null;

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming, past } = splitEvents(await getEvents(lang));
const featured = upcoming[0] ?? past[0];
const featuredLabel = upcoming[0] ? t('home.nextEvent') : t('home.latestEvent');

const { Content: Despre } = await getPage('despre', lang);

// Caruselul de pe prima pagină: prima fotografie a fiecărei amintiri, cele mai noi primele.
const carouselImages = (await getMemoriesByYear(lang))
  .flatMap(({ entries }) => entries)
  .filter(({ memory }) => memory.data.images.length > 0)
  .map(({ memory, slug }) => ({
    src: memory.data.images[0]!.src,
    alt: memory.data.images[0]!.alt,
    href: localePath(lang, `/amintiri/${slug}/`),
    caption: memory.data.title,
  }));
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  <!-- Hero -->
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:py-16 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t('home.eyebrow')}</p>
        <h1 class="mt-3 font-serif text-4xl font-bold leading-tight text-brand-950 sm:text-5xl">
          {t('site.name')}
        </h1>
        <p class="mt-4 max-w-prose text-lg leading-relaxed text-stone-600">{t('home.tagline')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(lang, '/evenimente/')}
            class="rounded-lg bg-brand-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
          >
            {t('home.allActivities')}
          </a>
          <a
            href={localePath(lang, '/amintiri/')}
            class="rounded-lg border border-brand-300 bg-white px-5 py-3 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {t('home.seeMemories')}
          </a>
          <a
            href={localePath(lang, '/contact/')}
            class="rounded-lg border border-brand-300 bg-white px-5 py-3 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {t('home.contactUs')}
          </a>
        </div>
      </div>
      <Image
        src={colaj}
        alt={t('home.heroAlt')}
        widths={[400, 700, 1000, 1400]}
        sizes="(min-width: 768px) 45vw, 62vw"
        format="webp"
        quality={65}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-xl border border-stone-200 shadow-md"
      />
    </div>
  </section>

  <!-- Apartenența la Mitropolie -->
  <section class="border-b border-stone-200 bg-brand-50" aria-labelledby="moreom-titlu">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-4 py-12 text-center sm:flex-row sm:gap-10 sm:text-left">
      {
        stemaColor ? (
          <img
            src={stemaColor}
            alt={t('home.moreomAlt')}
            width="240"
            height="288"
            loading="lazy"
            decoding="async"
            class="h-36 w-auto shrink-0 sm:h-44"
          />
        ) : (
          <Image src={stema} alt={t('home.moreomAlt')} width="130" height="143" format="webp" class="h-28 w-auto shrink-0 sm:h-32" loading="lazy" />
        )
      }
      <h2 id="moreom-titlu" class="font-serif text-2xl font-bold leading-snug text-brand-950 sm:text-3xl">
        {t('home.moreomTitle')}
      </h2>
    </div>
  </section>

  <!-- Un singur eveniment, ales automat după dată, prezentat central -->
  <section class="mx-auto max-w-4xl px-4 py-12 text-center sm:py-16" aria-labelledby="eveniment-evidentiat">
    <h2 id="eveniment-evidentiat" class="text-2xl font-bold uppercase tracking-wide text-brand-950 sm:text-3xl">
      {featuredLabel}
    </h2>
    {upcoming.length === 0 && <p class="mx-auto mt-3 max-w-prose text-stone-600">{t('home.noUpcoming')}</p>}
    {
      upcoming[0] ? (
        <div class="mt-6 text-left">
          <EventCard event={upcoming[0]} lang={lang} detailed headingLevel="h3" />
        </div>
      ) : (
        featured && (
          <article class="mx-auto mt-6 max-w-xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-semibold text-brand-900">
              <a href={localePath(lang, '/evenimente/')} class="hover:underline">
                {featured.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-stone-600">
              <time datetime={featured.data.date.toISOString().slice(0, 10)}>
                {formatDate(featured.data.date, lang)}
              </time>
              {featured.data.location && <> · {featured.data.location}</>}
            </p>
          </article>
        )
      )
    }
    <p class="mt-8">
      <a
        href={localePath(lang, '/evenimente/')}
        class="inline-block rounded-full bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
      >
        {t('home.allActivities')} →
      </a>
    </p>
  </section>

  <!-- Bandă de imagini pe toată lățimea, cu momente din toate evenimentele -->
  <section class="border-t border-stone-200 bg-white py-12 sm:py-16" aria-label={t('carousel.label')}>
    <GalleryMarquee images={carouselImages} lang={lang} />
    <p class="mt-8 text-center">
      <a
        href={localePath(lang, '/amintiri/')}
        class="inline-block rounded-full bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
      >
        {t('home.seeMemories')} →
      </a>
    </p>
  </section>

  <!-- Despre -->
  <section class="border-t border-stone-200 bg-white" aria-labelledby="despre-titlu">
    <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:py-16">
      <h2 id="despre-titlu" class="text-2xl font-bold text-brand-950 sm:text-3xl">
        {t('home.about.title')}
      </h2>
      <div class="prose-md mt-6 text-left text-stone-700 sm:text-center">
        <Despre />
      </div>
      <p class="mt-8 text-stone-600">
        {t('home.moreAbout')}
        <a
          href={localePath(lang, '/amintiri/')}
          class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
        >
          {t('home.moreAboutLink')}
        </a>
      </p>
    </div>
  </section>
</Base>
