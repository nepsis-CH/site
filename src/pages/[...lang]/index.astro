---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import GalleryMarquee from '../../components/GalleryMarquee.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import colaj from '../../assets/nepsis-elvetia.jpg';
import stema from '../../assets/stema-mitropolia-color.png';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming } = splitEvents(await getEvents(lang));

const { Content: Despre } = await getPage('despre', lang);

// Caruselul de pe prima pagină: prima fotografie a fiecărei amintiri, cele mai noi primele.
const carouselImages = (await getMemoriesByYear(lang))
  .flatMap(({ entries }) => entries)
  .filter(({ memory }) => memory.data.images.length > 0)
  .map(({ memory, slug }) => ({
    src: memory.data.images[0]!.src,
    alt: memory.data.images[0]!.alt,
    href: localePath(lang, `/amintiri/${slug}/`),
    caption: memory.data.title,
  }));

// Cele trei feluri de activități, cu pictograme desenate inline (fără librării).
const activitati = [
  {
    titlu: t('home.activities.meetings'),
    text: t('home.activities.meetingsText'),
    // Doi oameni pe drum
    icon: 'M9 20H4v-2a3 3 0 0 1 5.36-1.86M9 20h6m-6 0v-2c0-.66.13-1.29.36-1.86m0 0A5 5 0 0 1 20 18v2h-5M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM7 10a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  },
  {
    titlu: t('home.activities.spiritual'),
    text: t('home.activities.spiritualText'),
    // Cruce
    icon: 'M12 3v18M8.5 7.5h7',
  },
  {
    titlu: t('home.activities.culture'),
    text: t('home.activities.cultureText'),
    // Notă muzicală
    icon: 'M9 18V5l10-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm10-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
];
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  {/*
    Deschiderea: colajul umple tot ecranul, apoi se retrage și rămâne pagina.
    Voalul nu blochează derularea și dispare de tot la final.
  */}
  <div class="intro" aria-hidden="true">
    <Image
      src={colaj}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      format="webp"
      quality={68}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Hero: elementele urcă pe rând, în spatele voalului -->
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:py-16 md:grid-cols-2">
      <div>
        <h1 class="urca urca-1 font-serif text-4xl font-bold leading-tight text-brand-950 sm:text-5xl">
          {t('site.name')}
        </h1>
        <p class="urca urca-1 mt-3 font-serif text-xl text-brand-700 sm:text-2xl">
          {t('home.subtitle')}
        </p>
        <p class="urca urca-2 mt-5 max-w-prose text-lg leading-relaxed text-stone-700">
          {t('home.lead')}
        </p>
        {/*
          Intervalul de vârstă e prima informație pe care o caută cineva care se
          întreabă dacă frăția i se adresează, așa că stă aici, în deschidere.
        */}
        <p class="urca urca-2 mt-3 font-semibold text-brand-700">{t('home.ageRange')}</p>
        <div class="urca urca-3 mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(lang, '/evenimente/')}
            class="rounded-lg border border-brand-300 bg-white px-5 py-3 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {t('home.nextEvent')}
          </a>
          <a
            href={localePath(lang, '/devino-membru/')}
            class="rounded-lg bg-brand-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
          >
            {t('nav.join')}
          </a>
          <a
            href={localePath(lang, '/contact/')}
            class="rounded-lg border border-brand-300 bg-white px-5 py-3 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {t('nav.contact')}
          </a>
        </div>
      </div>
      <Image
        src={colaj}
        alt={t('home.heroAlt')}
        widths={[400, 700, 1000, 1400]}
        sizes="(min-width: 768px) 45vw, 62vw"
        format="webp"
        quality={65}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-xl border border-stone-200 shadow-md"
      />
    </div>
  </section>

  <!-- Următorul eveniment, prezentat central -->
  <section class="mx-auto max-w-4xl px-4 py-12 text-center sm:py-16" aria-labelledby="eveniment-evidentiat">
    <h2 id="eveniment-evidentiat" class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">
      {t('home.nextEvent')}
    </h2>
    {
      upcoming[0] && (
        <div class="mt-6 text-left">
          <EventCard event={upcoming[0]} lang={lang} detailed headingLevel="h3" />
        </div>
      )
    }
    <p class="mt-8">
      <a
        href={localePath(lang, '/evenimente/')}
        class="inline-block rounded-full bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
      >
        {t('home.allActivities')} →
      </a>
    </p>
    {upcoming.length === 0 && <p class="mx-auto mt-6 max-w-prose text-stone-600">{t('home.noUpcoming')}</p>}
  </section>

  <!-- Activitățile noastre: trei feluri de a fi împreună -->
  <section class="border-y border-stone-200 bg-brand-50/60" aria-labelledby="activitati-titlu">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <h2
        id="activitati-titlu"
        class="text-center font-serif text-3xl font-bold text-brand-950 sm:text-4xl"
      >
        {t('home.activities.title')}
      </h2>
      <ul class="mt-10 grid gap-8 sm:grid-cols-3 sm:gap-6">
        {
          activitati.map((a) => (
            <li class="flex flex-col items-center text-center sm:items-start sm:text-left">
              <span
                class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-brand-700 shadow-sm ring-1 ring-brand-200"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="h-6 w-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={a.icon} />
                </svg>
              </span>
              <h3 class="mt-4 font-serif text-xl font-bold text-brand-950">{a.titlu}</h3>
              <p class="mt-2 text-stone-700">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Despre -->
  <section class="border-b border-stone-200 bg-white" aria-labelledby="despre-titlu">
    <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:py-16">
      <h2 id="despre-titlu" class="scroll-mt-24 text-2xl font-bold text-brand-950 sm:text-3xl">
        {t('home.about.title')}
      </h2>
      <div class="prose-md mt-6 text-left text-stone-700 sm:text-center">
        <Despre />
      </div>
      <p class="mt-8 text-stone-600">
        {t('home.moreAbout')}
        <a
          href={localePath(lang, '/amintiri/')}
          class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
        >
          {t('home.moreAboutLink')}
        </a>
      </p>
    </div>
  </section>

  <!-- Bandă de imagini pe toată lățimea, cu momente din toate evenimentele -->
  <section class="bg-white py-12 sm:py-16" aria-label={t('carousel.label')}>
    <GalleryMarquee images={carouselImages} lang={lang} />
    <p class="mt-8 text-center">
      <a
        href={localePath(lang, '/amintiri/')}
        class="inline-block rounded-full bg-brand-700 px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-800"
      >
        {t('home.seeMemories')} →
      </a>
    </p>
  </section>

  <!-- Invitația, pe roșu: butonul alb e singurul lucru de făcut aici -->
  <section class="bg-brand-800 text-white" aria-labelledby="alatura-te">
    <div
      class="mx-auto flex max-w-5xl flex-col items-center gap-5 px-4 py-12 text-center sm:flex-row sm:justify-between sm:gap-8 sm:text-left"
    >
      <div>
        <h2 id="alatura-te" class="font-serif text-2xl font-bold sm:text-3xl">{t('contact.joinTitle')}</h2>
        <p class="mt-1 text-brand-100">{t('contact.joinText')}</p>
      </div>
      <a
        href={localePath(lang, '/devino-membru/')}
        class="shrink-0 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand-900 shadow-sm transition-colors hover:bg-brand-50"
      >
        {t('nav.join')}
      </a>
    </div>
  </section>

  <!-- Apartenența la Mitropolie închide pagina -->
  <section class="border-t border-stone-200 bg-brand-50" aria-labelledby="moreom-titlu">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-4 py-12 text-center sm:flex-row sm:gap-10 sm:text-left">
      <Image
        src={stema}
        alt={t('home.moreomAlt')}
        width="288"
        height="311"
        format="webp"
        loading="lazy"
        class="h-36 w-auto shrink-0 sm:h-44"
      />
      <h2 id="moreom-titlu" class="font-serif text-2xl font-bold leading-snug text-brand-950 sm:text-3xl">
        {t('home.moreomTitle')}
      </h2>
    </div>
  </section>
</Base>
