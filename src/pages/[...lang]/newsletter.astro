---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const formUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLScUYtvr7ZKbcWlpaoJAHWHD7Z9M13pSpaMhk--tf4eGIky3sA/viewform';
---

<Base lang={lang} title={`${t('newsletter.title')} · ${t('site.name')}`} description={t('newsletter.description')}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('newsletter.heading')}</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600">{t('newsletter.text')}</p>

    <div class="mt-8 overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
      <iframe
        src={`${formUrl}?embedded=true`}
        width="100%"
        height="800"
        loading="lazy"
        title={t('newsletter.heading')}></iframe>
    </div>

    <p class="mt-6 text-stone-600">
      {t('newsletter.fallback')}
      <a
        href={formUrl}
        target="_blank"
        rel="noopener"
        class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-900"
      >
        {t('newsletter.openForm')}
      </a>
    </p>
  </div>
</Base>
