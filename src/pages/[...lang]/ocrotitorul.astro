---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import icoana from '../../assets/iconita-sf-Casian-fata.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('ocrotitorul', lang);
---

<Base
  lang={lang}
  title={`${t('patron.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('patron.description')}
  ogImage="/img/iconita-sf-Casian-fata.jpg"
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <header class="text-center">
      <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('patron.title')}</h1>
      <p class="mt-2 text-lg text-stone-600">{t('patron.subtitle')}</p>
    </header>
    <div class="mt-10 gap-10 md:grid md:grid-cols-5">
      <Image
        src={icoana}
        alt={t('patron.iconAlt')}
        widths={[320, 640, 900]}
        sizes="(min-width: 768px) 38vw, 20rem"
        format="webp"
        quality={70}
        fetchpriority="high"
        decoding="async"
        class="mx-auto w-full max-w-xs rounded-xl border border-stone-200 shadow-md md:col-span-2 md:max-w-none"
      />
      <div class="prose-md mt-8 text-stone-700 md:col-span-3 md:mt-0">
        <Content />
      </div>
    </div>
  </div>
</Base>
