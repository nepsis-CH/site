---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('psaltica.title')}</h1>

    <div class="mt-10 gap-10 lg:grid lg:grid-cols-2">
      <div>
        <Image
          src={psalticaLogo}
          alt={t('psaltica.logoAlt')}
          widths={[400, 700, 1000]}
          sizes="(min-width: 640px) 28rem, 62vw"
          format="webp"
          quality={70}
          fetchpriority="high"
          decoding="async"
          class="w-full max-w-md rounded-xl border border-stone-200 shadow-sm"
        />
        <div class="prose-md mt-8 text-stone-700">
          <Content />
        </div>
      </div>
      <div class="mt-12 lg:mt-0">
        <h2 class="text-2xl font-bold text-brand-950">{t('psaltica.testimonials')}</h2>
        <!-- Harta interactivă (ArcGIS) se încarcă abia la click, ca pagina să rămână rapidă. -->
        <div
          id="marturii-fatada"
          class="mt-4 flex h-[500px] items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-brand-50 shadow-sm"
          data-src="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f?cover=false"
          data-title={t('psaltica.testimonials')}
        >
          <button
            type="button"
            class="rounded-lg bg-brand-800 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
          >
            {t('psaltica.testimonials')} →
          </button>
        </div>
        <noscript>
          <p class="mt-3">
            <a
              href="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f"
              target="_blank"
              rel="noopener"
              class="text-brand-700 underline"
            >
              {t('psaltica.testimonials')}
            </a>
          </p>
        </noscript>
      </div>
    </div>
  </div>
</Base>

<script>
  // Înlocuiește fațada cu iframe-ul ArcGIS abia la click.
  const fatada = document.getElementById('marturii-fatada');
  fatada?.querySelector('button')?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = fatada.dataset.src ?? '';
    iframe.title = fatada.dataset.title ?? '';
    iframe.width = '100%';
    iframe.height = '500';
    iframe.allowFullscreen = true;
    iframe.allow = 'geolocation';
    fatada.replaceChildren(iframe);
  });
</script>
