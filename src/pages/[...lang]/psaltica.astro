---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
const { Content: Materiale } = await getPage('psaltica-materiale', lang);

// Programul, ca patru câmpuri scurte: se citește dintr-o privire.
const program = [
  { eticheta: t('psaltica.when'), valoare: t('psaltica.whenText') },
  { eticheta: t('psaltica.where'), valoare: t('psaltica.whereText') },
  { eticheta: t('psaltica.duration'), valoare: t('psaltica.durationText') },
  { eticheta: t('psaltica.forWhom'), valoare: t('psaltica.forWhomText') },
];
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('psaltica.title')}</h1>

    <div class="mt-10 gap-10 lg:grid lg:grid-cols-2">
      <div>
        <Image
          src={psalticaLogo}
          alt={t('psaltica.logoAlt')}
          widths={[400, 700, 1000]}
          sizes="(min-width: 640px) 28rem, 62vw"
          format="webp"
          quality={70}
          fetchpriority="high"
          decoding="async"
          class="w-full max-w-md rounded-xl border border-stone-200 shadow-sm"
        />
        <div class="prose-md mt-8 text-stone-700">
          <Content />
        </div>
      </div>

      <div class="mt-10 lg:mt-0">
        <!-- Programul lecțiilor -->
        <section aria-labelledby="program">
          <h2 id="program" class="text-2xl font-bold text-brand-950">{t('psaltica.schedule')}</h2>
          <dl class="mt-4 divide-y divide-stone-200 overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
            {
              program.map((rand) => (
                <div class="flex flex-col gap-0.5 p-4 sm:flex-row sm:items-baseline sm:gap-4">
                  <dt class="shrink-0 text-sm font-semibold uppercase tracking-wide text-brand-600 sm:w-32">
                    {rand.eticheta}
                  </dt>
                  <dd class="text-stone-800">{rand.valoare}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Invitația de a participa -->
        <section class="mt-10" aria-labelledby="participi">
          <h2 id="participi" class="text-2xl font-bold text-brand-950">{t('psaltica.join')}</h2>
          <p class="mt-3 text-stone-700">{t('psaltica.joinText')}</p>
          <p class="mt-5">
            <!-- Butonul asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
            <a
              href="#"
              class="email-protejat-buton inline-block rounded-lg bg-brand-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
              data-x="nepsis.ch"
              data-y="mitropolia"
              data-z="eu"
            >
              {t('psaltica.emailButton')}
            </a>
          </p>
        </section>
      </div>
    </div>

    <!-- Materiale pentru repetiții -->
    <section class="mt-14" aria-labelledby="materiale">
      <h2 id="materiale" class="text-2xl font-bold text-brand-950">{t('psaltica.materials')}</h2>
      <div class="prose-md mt-4 text-stone-700">
        <Materiale />
      </div>
    </section>
  </div>
</Base>

<script>
  // Același mecanism anti-spam ca pe pagina de contact.
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>
